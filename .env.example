# ============================================================
# STARK BANK CHALLENGE - Environment Configuration
# ============================================================
# This file contains all environment variables needed to run the application.
# Copy this file to .env and fill in the actual values.
#
# For detailed configuration instructions, see docs/configuration.md
# ============================================================

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# Application name (used in logs and monitoring)
APP_NAME=stark-bank-challenge

# Environment: development, staging, or production
# Affects logging level, error handling, and feature flags
APP_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: DEBUG or INFO
# Production: INFO or WARNING
LOG_LEVEL=INFO

# API Server Configuration
# Port where the FastAPI server will listen
API_PORT=8000

# Host interface (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
API_HOST=0.0.0.0

# ============================================================
# SECURITY
# ============================================================

# Admin API Key for protected endpoints (invoices, transfers)
# IMPORTANT: Generate a strong random key for production!
# Example generation: openssl rand -hex 32
# Leave empty to disable API key authentication (NOT recommended for production)
ADMIN_API_KEY=dev-api-key-change-in-production

# ============================================================
# STARK BANK SETTINGS
# ============================================================

# Private Key Content (ECDSA Private Key)
# Generate via Stark Bank CLI or Dashboard
# Format: Full PEM content including headers
# Example:
# STARKBANK_PRIVATE_KEY_CONTENT=-----BEGIN EC PRIVATE KEY-----
# MHQCAQEEIAbc...xyz123
# -----END EC PRIVATE KEY-----
#
# For development/testing: Get from Stark Bank Sandbox
# For production: Get from Stark Bank Production environment
STARKBANK_PRIVATE_KEY_CONTENT=-----BEGIN EC PRIVATE KEY-----...-----END EC PRIVATE KEY-----

# Project ID from Stark Bank Dashboard
# Sandbox example: 5656565656565656
# Get it from: https://web.sandbox.starkbank.com/
STARKBANK_PROJECT_ID=your-project-id-here

# Stark Bank Environment: sandbox or production
# Use "sandbox" for development and testing
# Use "production" only when ready for real transactions
STARKBANK_ENVIRONMENT=sandbox

# ============================================================
# DATABASE
# ============================================================

# Database connection URL
# SQLite (default): sqlite:///./starkbank.db
# SQLite in-memory (tests): sqlite:///:memory:
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
#
# For development: SQLite is sufficient
# For production: Consider PostgreSQL for better concurrency and reliability
DATABASE_URL=sqlite:///./starkbank.db

# ============================================================
# SCHEDULER CONFIGURATION
# ============================================================

# Invoice Generation Interval (in hours)
# How often the scheduler will generate new invoices
# Default: 3 (generates invoices every 3 hours, 8 times per day)
# Range: 1-24
SCHEDULER_INTERVAL_HOURS=3

# Invoice Generation Quantity Range
# The scheduler will generate a random number of invoices between MIN and MAX
# Default: 8-12 invoices per execution
# These values ensure variability in the generation process
INVOICE_GENERATION_MIN=8
INVOICE_GENERATION_MAX=12

# ============================================================
# OPTIONAL SETTINGS (with defaults)
# ============================================================

# Stark Bank API Retry Configuration
# MAX_RETRIES=3
# RETRY_DELAY_SECONDS=2
# RETRY_BACKOFF_FACTOR=2

# Webhook Signature Validation
# WEBHOOK_SIGNATURE_REQUIRED=true

# Request Timeout (seconds)
# API_TIMEOUT=30

# ============================================================
# NOTES
# ============================================================
# 1. Never commit the actual .env file to version control
# 2. Keep this .env.example file updated when adding new variables
# 3. For production deployment:
#    - Generate strong random API keys
#    - Use production Stark Bank credentials
#    - Consider using PostgreSQL instead of SQLite
#    - Set LOG_LEVEL to INFO or WARNING
#    - Set APP_ENV to production
# 4. See docs/configuration.md for detailed setup instructions
# ============================================================
