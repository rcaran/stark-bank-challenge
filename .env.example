# Application Settings
APP_NAME=stark-bank-challenge
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# Security
# Chave secreta para assinatura de tokens ou cookies (se necessário)
SECRET_KEY=change_me_in_production
# API Key interna para proteção de endpoints administrativos (opcional)
ADMIN_API_KEY=admin123

# Stark Bank Settings
# Private key content (generated via Stark Bank CLI)
STARKBANK_PRIVATE_KEY_CONTENT=-----BEGIN EC PRIVATE KEY-----...-----END EC PRIVATE KEY-----
# Project ID do ambiente Sandbox do Stark Bank
STARKBANK_PROJECT_ID=1234567890
# Environment: sandbox or production
STARKBANK_ENVIRONMENT=sandbox

# Database
# Caminho para o arquivo SQLite
DATABASE_URL=sqlite:///./starkbank.db

# Scheduler
# Intervalo de execução do scheduler em horas (default: 3)
SCHEDULER_INTERVAL_HOURS=3
# Quantidade de invoices a gerar por execução (random entre min e max)
INVOICE_GENERATION_MIN=8
INVOICE_GENERATION_MAX=12
